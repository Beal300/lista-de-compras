# Optional configuration. Copy to .env only when defaults need changing.
# No password here: define it interactively with npm run setup.
PORT=3000
HOST=0.0.0.0
DATA_DIR=data
BACKUP_DIR=backups
COOKIE_SECURE=false
# Defaults allow localhost and the computer's current local IPv4 addresses.
# For development, explicitly include both API and Vite origins, for example:
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# Restart the server after changing these settings.
