{
  "name": "lista-de-compras-inteligente",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "setup": "node --env-file-if-exists=.env dist-server/cli.js setup",
    "password": "node --env-file-if-exists=.env dist-server/cli.js password",
    "backup": "node --env-file-if-exists=.env dist-server/cli.js backup",
    "restore": "node --env-file-if-exists=.env dist-server/cli.js restore",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
